# ── Gemini (Google AI Studio free tier) ─────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run in offline fallback mode (no AI calls at all).
GEMINI_API_KEY=

# Free-tier model. Only free-tier models are allowed while PAID_AI_DISABLED=true.
GEMINI_MODEL=gemini-2.5-flash

# ── Cost / quota guard ──────────────────────────────────────────────
# true (default): refuse any model that is not on the known free-tier list.
PAID_AI_DISABLED=true

# Hard cap on Gemini calls per calendar day. When reached, learning-harness
# stops calling the API and falls back to offline notes with a clear message.
MAX_DAILY_CALLS=20

# ── Server ──────────────────────────────────────────────────────────
PORT=3456

# ── Folders (macOS defaults; ~ is expanded) ─────────────────────────
# Folder watched for new .txt / .vtt / .srt / .md transcripts.
WATCH_DIR=~/Documents/Zoom
# Where generated Markdown notes are written.
VAULT_DIR=~/LearningVault
# Internal state: SQLite db + live session transcripts.
DATA_DIR=~/.learning-harness

# ── Output language ─────────────────────────────────────────────────
# Language for generated notes and rolling summaries (e.g. "vi" for
# Vietnamese, "en"). Empty = same language as the transcript. Individual
# notes can also be translated on demand from the dashboard.
OUTPUT_LANGUAGE=

# ── Live rolling summary ────────────────────────────────────────────
# Regenerate the rolling summary every N chunks, or every N minutes,
# whichever happens first (requires GEMINI_API_KEY).
SUMMARY_EVERY_CHUNKS=10
SUMMARY_EVERY_MINUTES=5

# Set to true to disable the folder watcher (live mode still works).
WATCH_DISABLED=false
